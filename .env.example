# =============================================================================
# RudrasFarmFresh — ONE .env at project root (copy to .env)
# =============================================================================
# APP_ENV=local        → LOCAL_* (Mac dev: npm run dev, php -S on port 8000)
# APP_ENV=production   → PROD_*  (Hostinger server)
# Backend, customer build, and admin build all read this file.
# Optional overrides: customer/.env.* or admin/.env.* (VITE_API_URL only)
# =============================================================================

APP_ENV=local

# --- localhost ---
LOCAL_APP_URL=http://localhost:8000
LOCAL_CUSTOMER_URL=http://localhost:5173
LOCAL_ADMIN_URL=http://localhost:5174
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=rudrasfarmfresh
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_RAZORPAY_KEY_ID=
LOCAL_RAZORPAY_KEY_SECRET=
LOCAL_RAZORPAY_WEBHOOK_SECRET=
LOCAL_SMTP_HOST=smtp.gmail.com
LOCAL_SMTP_PORT=587
LOCAL_SMTP_USERNAME=
LOCAL_SMTP_PASSWORD=
LOCAL_SMTP_FROM_EMAIL=
LOCAL_SMTP_FROM_NAME=RudrasFarmFresh
LOCAL_GOOGLE_MAPS_API_KEY=
LOCAL_AUTH_OTP_ENABLED=false

# --- production (https://rudrasfarmfresh.in) ---
PROD_APP_URL=https://api.rudrasfarmfresh.in
PROD_CUSTOMER_URL=https://rudrasfarmfresh.in
PROD_ADMIN_URL=https://admin.rudrasfarmfresh.in
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=3306
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_RAZORPAY_KEY_ID=
PROD_RAZORPAY_KEY_SECRET=
PROD_RAZORPAY_WEBHOOK_SECRET=
PROD_SMTP_HOST=smtp.gmail.com
PROD_SMTP_PORT=587
PROD_SMTP_USERNAME=
PROD_SMTP_PASSWORD=
PROD_SMTP_FROM_EMAIL=
PROD_SMTP_FROM_NAME=RudrasFarmFresh
PROD_GOOGLE_MAPS_API_KEY=
PROD_AUTH_OTP_ENABLED=false
